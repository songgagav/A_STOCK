# ============================================================
# .env.example — 环境变量模板 (复制为 .env 并按需填写, 勿提交真实密钥)
# 本项目大部分配置在 config.py 内; 以下环境变量可覆盖默认值.
# ============================================================

# ---- 数据源存储后端 (h5i 为 m4 起主数据湖; duck 仅作历史对照, 已退役) ----
BAR_STORE=h5i

# ---- 因子融合与打分开关 ----
FUSION_SCORE=1            # 1=四因子 ICIR 加权融合; 0=关闭走旧 f_ml
FORCE_FML=0               # 1=强制旧 ml_fusion_bridge(调试对照)

# ---- IC 门控 (factor_gate) ----
FACTOR_GATE_ENABLED=1
FACTOR_GATE_CONFIG=       # 可选: 指向自定义门控配置 JSON 的路径
# FG_IC_WINDOW=20
# FG_IC_NORMAL_MEAN=0.005
# FG_IC_RISK_MEAN_J=-0.005
# FG_IC_NEG_SHARE_RISK=0.55
# FG_FACTOR_IC_DRIFT=0.15
# FG_SHARPE_CHANGE_THRESHOLD=0.3
# FG_EXP_CAUTION=0.9
# FG_EXP_RISK=0.8

# ---- 风控 (risk_first / CVaR / 熔断) ----
RISK_FIRST_ENABLED=1
CVAR_ALPHA=0.05
CVAR_COEF=0.1
RF_CB_DRAWDOWN=0.08
RF_CB_VOL=0.35

# ---- LLM 增强(可选; 不配置则相应 agent 功能降级) ----
# [2026-09-28] 支持三种协议, 由 LLM_API_TYPE 指定:
#   ollama    -> POST <base>/api/chat                (本地 Ollama 原生路由)
#   openai    -> POST <base>/v1/chat/completions
#   anthropic -> POST <base>/anthropic/v1/messages    (MiniMax 等)
# 留空则按 OPENAI_BASE_URL 自动推断: 含 `:11434` -> ollama; 含 `openai` 或
# `chat/completions` -> openai; 其余回落 anthropic(保持对既有部署的向后兼容)。
#
# 注意加载顺序: 进程环境变量 > <工作区>/research_trader/.env > 本仓 .env。
# 同一个键两处都写时, research_trader/.env 生效。
#
# OPENAI_BASE_URL=http://192.168.1.5:11434      # 局域网 Ollama
# OPENAI_MODEL=qwen3.6:35b                      # 该端点上 ollama list 可见的名字
# OPENAI_TIMEOUT_SECONDS=180                    # 本地 36B 模型单次可能数十秒, 给足
# OPENAI_API_KEY=                              # 本地端点无鉴权, 可留空
# LLM_API_TYPE=ollama
# LLM_THINK=0                                   # Ollama 原生: 关掉思维链(只要 JSON)
# OLLAMA_NUM_PREDICT=0                          # 可选: 映射到 options.num_predict
#
# 切回云端 MiniMax 时:
# OPENAI_BASE_URL=https://api.minimaxi.com/anthropic
# OPENAI_MODEL=MiniMax-M3
# OPENAI_API_KEY=<你的 key>                     # anthropic 协议**必须**有 key
# LLM_API_TYPE=anthropic

# ---- 可选: 交易/调度/面板 ----
# DASH_PORT=8000
# TRADE_BROKER=paper
